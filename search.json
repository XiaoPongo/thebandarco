---
---
[
  {% assign all_entries = site.posts | concat: site.pages %}
  {% for item in all_entries %}
    {% if item.title %}
      {
        "title": {{ item.title | jsonify }},
        "category": {{ item.category | default: "" | jsonify }},
        "tags": {{ item.tags | jsonify }},
        "url": "{{ site.baseurl }}{{ item.url }}",
        "date": "{{ item.date | date_to_string }}",
        "content": {{ item.content | strip_html | strip_newlines | truncate: 300 | jsonify }}
      }{% unless forloop.last %},{% endunless %}
    {% endif %}
  {% endfor %}
]
