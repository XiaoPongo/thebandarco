---
layout: null
---
[
  {% assign first = true %}
  {% for post in site.posts %}
    {% unless first %},{% endunless %}
    {
      "title": {{ post.title | escape | replace: "\n", " " | replace: "\r", " " | replace: "\t", " " | jsonify }},
      "url": {{ post.url | prepend: site.baseurl | jsonify }},
      "date": {{ post.date | date_to_xmlschema | jsonify }}
    }
    {% assign first = false %}
  {% endfor %}
  {% for page in site.pages %}
    {% if page.title and page.url != "/search.json" %}
      ,{
        "title": {{ page.title | escape | replace: "\n", " " | replace: "\r", " " | replace: "\t", " " | jsonify }},
        "url": {{ page.url | prepend: site.baseurl | jsonify }},
        "date": null
      }
    {% endif %}
  {% endfor %}
]
