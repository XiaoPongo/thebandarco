---
layout: null
permalink: /search.json
---

[
  {% for post in site.posts %}
    {
      "title": "{{ post.title | escape }}",
      "url": "{{ post.url | relative_url }}",
      "date": "{{ post.date | date: "%B %-d, %Y" }}",
      "content": {{ post.content | markdownify | strip_html | normalize_whitespace | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
  {% if site.pages.size > 0 %},{% endif %}
  {% for page in site.pages %}
    {% unless page.url contains '.xml' or page.url == '/' or page.url == '/search.json' %}
    {
      "title": "{{ page.title | default: page.url | escape }}",
      "url": "{{ page.url | relative_url }}",
      "date": "",
      "content": {{ page.content | markdownify | strip_html | normalize_whitespace | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endunless %}
  {% endfor %}
]
