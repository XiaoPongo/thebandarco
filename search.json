---
layout: none
permalink: /search.json
---
[
  {% assign all_pages = site.pages | concat: site.posts %}
  {% for page in all_pages %}
    {% unless page.url contains '/tags/' or page.url contains '/categories/' or page.url contains '/journal/' or page.url contains 'feed.xml' or page.search == false %}
      {
        "title": {{ page.title | jsonify }},
        "url": {{ page.url | prepend: site.baseurl | jsonify }},
        "content": {{ page.content | strip_html | strip_newlines | jsonify }},
        {% if page.date %}
        "date": {{ page.date | date_to_xmlschema | jsonify }}
        {% else %}
        "date": null
        {% endif %}
      }{% unless forloop.last %},{% endunless %}
    {% endunless %}
  {% endfor %}
]
