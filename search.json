---
layout: null
---

[
  {% assign all_items = site.posts | concat: site.pages %}
  {% assign filtered_items = all_items | where_exp: "item", "item.title" %}
  {% for item in filtered_items %}
    {
      "title": {{ item.title | jsonify }},
      "category": {{ item.category | default: "" | jsonify }},
      "tags": {{ item.tags | default: [] | join: ", " | jsonify }},
      "url": {{ site.baseurl | append: item.url | jsonify }},
      "date": {{ item.date | date: "%Y-%m-%d" | jsonify }},
      "content": {{ item.content | strip_html | strip_newlines | jsonify }}
    }{% unless forloop.last %},{% endunless %}
  {% endfor %}
]
