---
layout: null
---
[
  {% assign first = true %}
  {% for post in site.posts %}
    {% unless first %},{% endunless %}
    {
      "title": "{{ post.title | escape }}",
      "url": "{{ post.url | prepend: site.baseurl }}",
      "date": "{{ post.date | date_to_xmlschema }}",
      "content": "{{ post.content | strip_html | escape }}"
    }
    {% assign first = false %}
  {% endfor %}
  {% for page in site.pages %}
    {% if page.title and page.url != "/search.json" and page.url != "/projects/" and page.url != "/projects/index.html" and page.url != "/projects/project-design-portfolio/index.html" and page.url != "/projects/project-website/index.html" %}
      ,{
        "title": "{{ page.title | escape }}",
        "url": "{{ page.url | prepend: site.baseurl }}",
        "date": null,
        "content": "{{ page.content | strip_html | escape }}"
      }
    {% endif %}
  {% endfor %}
]
